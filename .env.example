# 🔐 Important : copier ce fichier en ".env" et remplacer les valeurs

# Base de données
DATABASE_URL="file:./dev.db"

# JWT — générer une clé forte en production
JWT_SECRET=super-secret-key-change-in-production

# Admin (premier compte créé via `npx prisma db seed`)
ADMIN_EMAIL=admin@loukman-immobilier.ci
ADMIN_PASSWORD=admin123

# SMTP (optionnel) — laisser vide pour déboguer dans la console
NUXT_EMAIL_HOST=
NUXT_EMAIL_USER=
NUXT_EMAIL_PASS=
NUXT_EMAIL_TO=

# Supabase Storage (uploads)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=votre_service_role_key

# URL du site (sitemap)
NUXT_PUBLIC_SITE_URL=https://loukman-immobilier.ci
