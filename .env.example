# 🔐 Important : copier ce fichier en ".env" et remplacer les valeurs

# Base de données (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres.user:password@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&client_encoding=utf8"
DIRECT_URL="postgresql://postgres.user:password@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# JWT — générer une clé forte en production
JWT_SECRET=generer-une-cle-aleatoire

# Admin (premier compte créé via `npx prisma db seed`)
ADMIN_EMAIL=admin@loukmanimmobilier.com
ADMIN_PASSWORD=generer-un-mot-de-passe-fort
ADMIN_NOM=Administrateur

# Secret de la route POST /api/auth/seed (création d'un compte admin)
# Obligatoire : sans lui, la route refuse toute création (403)
ADMIN_SEED_SECRET=generer-un-secret-long-et-aleatoire

# Secret du cron de keepalive Supabase (GET /api/cron/keepalive)
# Vercel envoie `Authorization: Bearer <CRON_SECRET>` quand la variable existe
CRON_SECRET=generer-un-secret-long-et-aleatoire

# SMTP Gmail
NUXT_EMAIL_HOST=smtp.gmail.com
NUXT_EMAIL_PORT=587
NUXT_EMAIL_USER=loukmanfreresimmobilier@gmail.com
NUXT_EMAIL_PASS=votre-mot-de-passe-app
NUXT_EMAIL_TO=loukmanfreresimmobilier@gmail.com

# Supabase Storage (uploads)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=votre_service_role_key

# URL publique du site (sitemap, canonical, og:url)
NUXT_PUBLIC_SITE_URL=https://loukmanimmobilier.com
